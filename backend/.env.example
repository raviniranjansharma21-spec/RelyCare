# RelyCare FastAPI Backend Environment Variables
PROJECT_NAME=RelyCare Backend API
API_V1_STR=/api/v1
ENVIRONMENT=development

# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relycare_db

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://localhost:8080"]
